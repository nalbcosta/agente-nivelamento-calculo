APP_NAME=Agente Nivelamento Calculo
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LESSON_MARKDOWN_PATH=/app/data/calculo_i_aula.md
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
LLM_PROVIDER=rule
LLM_TEMPERATURE=0.2
LLM_MAX_NEW_TOKENS=320
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b
# Quando LLM_PROVIDER=ollama ou huggingface, o fluxo usa LangChain por padrao.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta
RAG_TOP_K_DEFAULT=4
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agente_nivelamento
